# Without MAIL_MODE (or with an incomplete hosted setup) every mail route stays off.
#
# Local, on this computer: `npm run dev` binds 127.0.0.1:3000 in local mode; PORT=3001 is also accepted.
# MAIL_MODE=local
#
# Hosted (Vercel). All of these are required, otherwise the app stays off.
# MAIL_MODE=hosted
# TU_HOSTED_APPROVED=yes
# MAIL_ORIGIN=https://your-domain.example
# TU_ALLOWED_USERS=*            # "*" = any @tu-sofia.bg address; or a comma-separated list
# DATABASE_URL=                 # Postgres (e.g. Neon via the Vercel Marketplace)
# APP_KEY=                      # 32 random bytes, base64; a secret, never commit it
# BLOB_READ_WRITE_TOKEN=        # private Vercel Blob store for outgoing attachments
# MAIL_PROXY=http://kampus:<RELAY_SECRET>@<relay-host>:8993
#                               # TU drops traffic from AWS (Vercel); route IMAPS/SMTP through relay/relay.mjs
#
# Private VM usage dashboard at /ops (optional; off when unset).
# OPS_USERS=you@tu-sofia.bg     # TU addresses allowed to open /ops after signing in
# OPS_INGEST_TOKEN=             # 32+ random chars; the same value goes in /etc/kampus-ops.env on the VM
#
# New-mail notifications (optional; off unless all four are set). Keys are generated on the VM, see push/.
# PUSH_WORKER_PUBLIC_KEY=       # X25519 public key of the VM push worker; logins are sealed to it
# NEXT_PUBLIC_VAPID_KEY=        # Web Push VAPID public key (the private key stays on the VM)
# PUSH_SYNC_SECRET=             # HMAC for API -> worker sync (same value in /etc/kampus-push.env)
# PUSH_WORKER_TOKEN=            # worker -> /api/push/* bearer token (same value in /etc/kampus-push.env)
# PUSH_MAX_ACCOUNTS=25
